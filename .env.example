# Variables de entorno para CineMatch
# Copia este archivo a .env.local y completa con tus valores reales

# Supabase (públicas: se usan en el navegador; la seguridad la dan las políticas RLS)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# TMDB API v3 (solo servidor: la usa el proxy /api/tmdb, nunca llega al navegador)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Acceso privado (opcional). Si se define, toda la web pide esta contraseña antes de entrar.
# Déjala vacía en local para trabajar sin la pantalla de acceso.
SITE_PASSWORD=
